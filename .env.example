# ==========================================
# 环境变量配置模板（请复制一份命名为 .env 并填入真实值）
# 注意：.env 包含真实密码与密钥，已被 .gitignore 忽略，切勿上传到 GitHub！
# ==========================================

# Steam API 授权密钥 (前往 https://steamcommunity.com/dev/apikey 申请)
STEAM_API_KEY=your_steam_api_key_here

# =========================
# 采集范围配置
# =========================
START_APPID=2000000
RECENT_YEARS=3
DATE_FROM=

# =========================
# 采集与限流控制
# =========================
MAX_APPS=0
MAX_DETAILS=0
REQUEST_INTERVAL=0.5
THREADS=3
COOLDOWN=30
RATE_RETRY=10

# =========================
# MySQL 数据库配置 (Azure MySQL / 远程服务)
# =========================
MYSQL_HOST=your_azure_mysql_host_or_ip
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=steam_db
MYSQL_TABLE=steam_games
